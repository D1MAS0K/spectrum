# ═══════════════════════════════════════════════════════
# Spectrum — Environment Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── WordPress / WooCommerce ──────────────────────────
WP_BASE_URL=https://dogsstate.co.il
WP_USER=your_wp_username
WP_APP_PASSWORD=your_wp_application_password
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AI Providers ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxx

# ── Google APIs ──────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://dogsstate.co.il
GA4_PROPERTY_ID=properties/XXXXXXXXX
GOOGLE_MERCHANT_ID=your_merchant_id

# ── SEO Tools ────────────────────────────────────────
SEMRUSH_API_KEY=your_semrush_key
SERPER_API_KEY=your_serper_key

# ── Social Media ─────────────────────────────────────
FACEBOOK_PAGE_ACCESS_TOKEN=your_fb_token
FACEBOOK_PAGE_ID=your_page_id
INSTAGRAM_ACCESS_TOKEN=your_ig_token
INSTAGRAM_BUSINESS_ID=your_ig_business_id

# ── Notifications ────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ── System ───────────────────────────────────────────
LOG_LEVEL=INFO
SNAPSHOT_INTERVAL_MINUTES=30
SCHEDULER_ENABLED=true
